<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/retroLight">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:src="@drawable/logo_aac" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CONVERSOR AAC"
        android:textSize="30sp"
        android:fontFamily="@font/vt323"
        android:textStyle="bold"
        android:textColor="@color/retroBrown"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- Panel de Grabación (Oculto por defecto) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/recordingPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/retroBrown"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <View
                android:id="@+id/recordingDot"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/ic_fa_stop"
                android:backgroundTint="#D32F2F"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textSize="24sp"
                android:fontFamily="@font/vt323"
                android:textColor="@color/retroYellow"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:id="@+id/tvRecordingName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Grabando..."
                android:textSize="18sp"
                android:fontFamily="@font/vt323"
                android:textColor="@color/retroLight"
                android:singleLine="true"
                android:ellipsize="end"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Botón de Grabación -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGrabar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Iniciar Grabación"
        android:fontFamily="@font/vt323"
        android:textSize="22sp"
        app:icon="@drawable/ic_fa_mic"
        app:iconGravity="textStart"
        app:cornerRadius="12dp"
        android:layout_marginBottom="16dp"
        app:backgroundTint="@color/retroBrown"
        android:textColor="@color/retroYellow"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAuditar"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Auditar"
            android:fontFamily="@font/vt323"
            android:textSize="18sp"
            app:icon="@drawable/ic_fa_search"
            app:iconGravity="textStart"
            app:cornerRadius="12dp"
            android:layout_marginEnd="8dp"
            app:backgroundTint="@color/retroBrown"
            android:textColor="@color/retroYellow"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConvertir"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Convertir"
            android:fontFamily="@font/vt323"
            android:textSize="18sp"
            app:icon="@drawable/ic_fa_play"
            app:iconGravity="textStart"
            app:cornerRadius="12dp"
            android:layout_marginStart="8dp"
            app:backgroundTint="@color/retroYellow"
            android:textColor="@color/retroBrown"/>
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="false"
        app:trackCornerRadius="4dp"
        app:indicatorColor="@color/retroBrown"
        android:layout_marginBottom="16dp"
        android:visibility="invisible"/>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/retroBrown">

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Esperando acción..."
                android:textSize="18sp"
                android:textColor="@color/retroYellow"
                android:fontFamily="@font/vt323"/>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
